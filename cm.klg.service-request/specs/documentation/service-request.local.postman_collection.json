          ]
        },
        {
          "name": "Rejeter une demande [PUT /service-request/{serviceRequestId}/reject]",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/service-request/{{serviceRequestId}}/reject",
            "description": "Rejette une demande adressée au prestataire connecté.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{providerToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reason\": \"Indisponible à la date demandée\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Réponse HTTP 204 attendue\", function () { pm.response.to.have.status(204); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Mes statistiques d'avis [GET /me/reviews/summary]",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/me/reviews/summary",
            "description": "Statistiques publiques des avis du prestataire connecté.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{providerToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Réponse HTTP 200 attendue\", function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Suivi (client ou prestataire associé)",
      "item": [
        {
          "name": "Lire le suivi [GET /service-request/{serviceRequestId}/follow-up]",
          "request": {
            "method": "GET",
            "header": [],
