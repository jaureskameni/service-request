{
  "info": {
    "name": "Z-Link · Service Request API (local)",
    "description": "Collection alignée sur specs/openapi/inbound/main.yml et la sécurité du service. Base locale : http://localhost:8086. Renseignez les tokens et remplacez les UUID d'exemple par des identifiants existants. Les routes publiques d'avis n'exigent pas de token.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "noauth"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8086",
      "type": "string"
    },
    {
      "key": "userToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "providerToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "moderatorToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "serviceRequestId",
      "value": "11111111-1111-4111-8111-111111111111",
      "type": "string"
    },
    {
      "key": "providerId",
      "value": "22222222-2222-4222-8222-222222222222",
      "type": "string"
    },
    {
      "key": "serviceTypeId",
      "value": "33333333-3333-4333-8333-333333333333",
      "type": "string"
    },
    {
      "key": "reviewId",
      "value": "44444444-4444-4444-8444-444444444444",
      "type": "string"
    },
    {
      "key": "status",
      "value": "PENDING",
      "type": "string"
    },
    {
      "key": "page",
      "value": "0",
      "type": "string"
    },
    {
      "key": "limit",
      "value": "10",
      "type": "string"
    },
    {
      "key": "answer",
      "value": "YES",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Demandes du client",
      "item": [
        {
          "name": "Créer une demande [POST /service-request]",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/service-request",
            "description": "Crée une demande. Le client doit être connecté; le prestataire ciblé doit être approuvé.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{userToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"providerId\": \"{{providerId}}\",\n  \"serviceTypeId\": \"{{serviceTypeId}}\",\n  \"title\": \"Réparation de plomberie\",\n  \"description\": \"Réparer une fuite sous l'évier.\",\n  \"location\": \"Douala\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Réponse HTTP 201 attendue\", function () { pm.response.to.have.status(201); });",
                  "if (pm.response.code === 201) { const body = pm.response.json(); if (body.newId) pm.collectionVariables.set(\"serviceRequestId\", body.newId); }"
                ]
              }
            }
          ]
        },
        {
          "name": "Lister mes demandes [GET /my/service-request]",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/my/service-request?status={{status}}&page={{page}}&limit={{limit}}",
            "description": "Liste paginée des demandes du client connecté. limit : 10 à 100; page : zéro ou plus.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{userToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Réponse HTTP 200 attendue\", function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Annuler une demande [PUT /service-request/{serviceRequestId}/cancel]",
          "request": {
            "method": "PUT",
            "header": [],
            "url": "{{baseUrl}}/service-request/{{serviceRequestId}}/cancel",
            "description": "Annule une demande appartenant au client connecté. Aucun corps.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{userToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Réponse HTTP 204 attendue\", function () { pm.response.to.have.status(204); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Publier un avis [POST /service-request/{serviceRequestId}/review]",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/service-request/{{serviceRequestId}}/review",
            "description": "Publie un avis si le client est éligible. Note de 1 à 5; commentaire optionnel, 2000 caractères maximum.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{userToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"rating\": 5,\n  \"comment\": \"Service rapide et soigné.\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Réponse HTTP 204 attendue\", function () { pm.response.to.have.status(204); });"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Demandes du prestataire",
      "item": [
        {
          "name": "Lister les demandes reçues [GET /my/provider/service-requests]",
          "request": {
            "method": "GET",
            "header": [],
