          "name": "Déclarer la fin du service [PUT /service-request/{serviceRequestId}/follow-up/service-completion]",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/service-request/{{serviceRequestId}}/follow-up/service-completion",
            "description": "Déclare YES ou NO pour la fin du service, lorsque l'action est disponible. Changez le token pour répondre comme prestataire.",
            "auth": {
