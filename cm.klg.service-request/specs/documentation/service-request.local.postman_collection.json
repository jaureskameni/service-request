          "name": "Lister les avis publics [GET /service-provider/{providerId}/reviews]",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/service-provider/{{providerId}}/reviews?limit={{limit}}&page={{page}}",
            "description": "Liste les avis publiés d'un prestataire approuvé. Appel public.",
            "auth": {
