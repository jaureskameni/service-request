    {
      "name": "Modération",
      "item": [
        {
          "name": "Masquer un avis [PUT /reviews/{reviewId}/moderation]",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/reviews/{{reviewId}}/moderation",
            "description": "Masque un avis. Le JWT doit avoir le rôle Keycloak review-moderate; motif de 1 à 2000 caractères.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{moderatorToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reason\": \"Contenu contraire aux règles de publication.\"\n}",
