                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/service-request/{{serviceRequestId}}/follow-up/agreement",
            "description": "Enregistre YES ou NO pour la partie correspondant au token. Changez le token pour répondre comme prestataire.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{userToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
