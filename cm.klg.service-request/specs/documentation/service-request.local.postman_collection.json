          "name": "Accepter une demande [PUT /service-request/{serviceRequestId}/accept]",
          "request": {
            "method": "PUT",
            "header": [],
            "url": "{{baseUrl}}/service-request/{{serviceRequestId}}/accept",
            "description": "Accepte une demande adressée au prestataire connecté. Aucun corps.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{providerToken}}",
                  "type": "string"
                }
