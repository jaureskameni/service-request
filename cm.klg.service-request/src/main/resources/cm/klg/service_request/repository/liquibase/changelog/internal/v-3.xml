<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
	xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.9.xsd">

	<changeSet id="SR-3:1" author="kameni.nguematcha">
		<addColumn tableName="t_user">
			<column name="c_identity_id" type="varchar(36)">
				<constraints nullable="false" unique="true" />
			</column>
		</addColumn>

		<dropForeignKeyConstraint
			baseTableName="t_service_provider"
			constraintName="fk_service_provider_user" />

		<dropForeignKeyConstraint
			baseTableName="t_service_request"
			constraintName="fk_service_request_user" />

		<addForeignKeyConstraint
			baseTableName="t_service_provider" baseColumnNames="c_user_id"
			constraintName="fk_service_provider_user"
			referencedTableName="t_user" referencedColumnNames="c_identity_id"
			onDelete="RESTRICT" onUpdate="CASCADE" />

		<addForeignKeyConstraint
			baseTableName="t_service_request" baseColumnNames="c_user_id"
			constraintName="fk_service_request_user" referencedTableName="t_user"
			referencedColumnNames="c_identity_id" onDelete="RESTRICT"
			onUpdate="CASCADE" />
	</changeSet>
	<changeSet id="SR-11:1" author="kameni.nguematcha">
		<addColumn tableName="t_service_request">
			<column name="c_deleted" type="boolean"
				defaultValueBoolean="false" />
			<column name="c_version" type="int8" defaultValueNumeric="0" />
		</addColumn>
	</changeSet>
	<changeSet id="SR-15:1" author="kameni.nguematcha">
		<addUniqueConstraint
			tableName="t_service_provider" columnNames="c_user_id"
			constraintName="uk_service_provider_user_id" />
	</changeSet>

</databaseChangeLog>
