<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
	xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.9.xsd">

	<changeSet id="SR-1:1" author="kameni.nguematcha">
		<createTable tableName="t_inbox_event">
			<column name="c_id" type="varchar(36)">
				<constraints nullable="false" primaryKey="true"
					primaryKeyName="pk_inbox_event" />
			</column>
			<column name="c_type" type="varchar(30)" />
			<column name="c_topic" type="varchar(20)" />
			<column name="c_key" type="varchar(36)" />
			<column name="c_data" type="text" />
			<column name="c_status" type="varchar(15)" />
			<column name="c_created_at" type="timestamp" />
			<column name="c_processed_at" type="timestamp" />
		</createTable>
		<createTable tableName="t_user">
			<column name="c_id" type="varchar(36)">
				<constraints nullable="false" primaryKey="true"
					primaryKeyName="pk_user" />
			</column>
			<column name="c_firstname" type="varchar(50)" />
			<column name="c_lastname" type="varchar(50)" />
			<column name="c_phone_number" type="varchar(20)" />
			<column name="c_email_address" type="varchar(255)" />
			<column name="c_is_service_provider" type="boolean"
				defaultValueBoolean="false" />
			<column name="c_created_at" type="timestamp" />
		</createTable>
		<createTable tableName="t_service_provider">
			<column name="c_id" type="varchar(36)">
				<constraints primaryKey="true" nullable="false"
					primaryKeyName="pk_service_provider" />
			</column>
			<column name="c_user_id" type="varchar(36)">
				<constraints nullable="false" />
			</column>
			<column name="c_status" type="varchar(15)" />
			<column name="c_approved_at" type="timestamp" />
		</createTable>

		<addForeignKeyConstraint
			baseTableName="t_service_provider" baseColumnNames="c_user_id"
			constraintName="fk_service_provider_user"
			referencedTableName="t_user" referencedColumnNames="c_id"
			onDelete="RESTRICT" onUpdate="CASCADE" />
	</changeSet>
</databaseChangeLog>