<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
	xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.9.xsd">

	<changeSet id="SP-1:1" author="kameni.nguematcha">
		<createTable tableName="t_user">
			<column name="c_id" type="uuid">
				<constraints nullable="false" primaryKey="true"
					primaryKeyName="pk_user" />
			</column>
			<column name="c_firstname" type="varchar(50)" />
			<column name="c_lastname" type="varchar(50)" />
			<column name="c_phone_number" type="varchar(20)" />
			<column name="c_email_address" type="varchar(255)" />
			<column name="c_created_at" type="datetime" />
		</createTable>
		<createTable tableName="t_inbox_event">
			<column name="c_id" type="uuid">
				<constraints nullable="false" primaryKey="true"
					primaryKeyName="pk_inbox_event" />
			</column>
			<column name="c_type" type="varchar(30)">
				<constraints nullable="false" />
			</column>
			<column name="c_topic" type="varchar(20)">
				<constraints nullable="false" />
			</column>
			<column name="c_key" type="varchar(36)">
				<constraints nullable="false" />
			</column>
			<column name="c_data" type="text">
				<constraints nullable="false" />
			</column>
			<column name="c_status" type="varchar(15)" />
			<column name="c_created_at" type="datetime">
				<constraints nullable="false" />
			</column>
			<column name="c_processed_at" type="datetime">
				<constraints nullable="false" />
			</column>
		</createTable>
	</changeSet>
	<changeSet id="SP-7:1" author="kameni.nguematcha">
		<dropNotNullConstraint tableName="t_inbox_event"
			columnName="c_processed_at" columnDataType="datetime" />
	</changeSet>
	<changeSet id="SP-8:1" author="kameni.nguematcha">

		<createTable tableName="t_service_type">
			<column name="c_id" type="uuid">
				<constraints primaryKey="true" nullable="false"
					primaryKeyName="pk_service_type" />
			</column>
			<column name="c_name" type="varchar(100)" />
			<column name="c_category" type="varchar(50)" />
			<column name="c_is_active" type="boolean"
				defaultValueBoolean="true" />
			<column name="c_created_at" type="datetime" />
			<column name="c_updated_at" type="datetime" />
		</createTable>

	</changeSet>
	<changeSet id="SP-8:2" author="kameni.nguematcha">
		<createTable tableName="t_service_provider">
			<column name="c_id" type="uuid">
				<constraints primaryKey="true" nullable="false"
					primaryKeyName="pk_service_provider" />
			</column>
			<column name="c_user_id" type="uuid">
				<constraints nullable="false" />
			</column>
			<column name="c_city" type="uuid">
				<constraints nullable="false" />
			</column>
			<column name="c_district" type="uuid">
				<constraints nullable="false" />
			</column>
			<column name="c_phone_number" type="varchar(15)" />
			<column name="c_status" type="varchar(15)" />
			<column name="c_approved_by" type="uuid" />
			<column name="c_rejected_by" type="uuid" />
			<column name="c_created_at" type="datetime" />
			<column name="c_updated_at" type="datetime" />
		</createTable>

		<addForeignKeyConstraint
			baseTableName="t_service_provider" baseColumnNames="c_user_id"
			constraintName="fk_service_provider_user"
			referencedTableName="t_user" referencedColumnNames="c_id"
			onDelete="RESTRICT" onUpdate="CASCADE" />

		<addForeignKeyConstraint
			baseTableName="t_service_provider" baseColumnNames="c_approved_by"
			constraintName="fk_service_provider_approved_by"
			referencedTableName="t_user" referencedColumnNames="c_id"
			onDelete="SET NULL" onUpdate="CASCADE" />

		<addForeignKeyConstraint
			baseTableName="t_service_provider" baseColumnNames="c_rejected_by"
			constraintName="fk_service_provider_rejected_by"
			referencedTableName="t_user" referencedColumnNames="c_id"
			onDelete="SET NULL" onUpdate="CASCADE" />

		<addUniqueConstraint
			tableName="t_service_provider" columnNames="c_user_id"
			constraintName="uq_service_provider_user_id" />

		<createTable tableName="t_user_service">
			<column name="c_service_provider_id" type="uuid" />
			<column name="c_service_type_id" type="uuid" />
			<column name="c_year_of_experience" type="int" />
			<column name="c_user_document" type="uuid" />
			<column name="c_created_at" type="datetime" />
		</createTable>

		<addPrimaryKey tableName="t_user_service"
			columnNames="c_service_provider_id, c_service_type_id"
			constraintName="pk_user_service" />

		<addForeignKeyConstraint
			baseTableName="t_user_service"
			baseColumnNames="c_service_provider_id"
			constraintName="fk_user_service_provider"
			referencedTableName="t_service_provider" referencedColumnNames="c_id"
			onDelete="CASCADE" onUpdate="CASCADE" />

		<addForeignKeyConstraint
			baseTableName="t_user_service" baseColumnNames="c_service_type_id"
			constraintName="fk_user_service_type"
			referencedTableName="t_service_type" referencedColumnNames="c_id"
			onDelete="RESTRICT" onUpdate="CASCADE" />

	</changeSet>
</databaseChangeLog>